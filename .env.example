# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交。
# 注意：此文件同时被 docker compose 和 Spring（local profile，按 properties 格式）读取，
# 因此注释必须独占一行，不要写在值的后面。

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kbagent
POSTGRES_USER=kbagent
POSTGRES_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ---------- 安全 ----------
# JWT 签名密钥：至少 32 字节的随机串，未设置时应用拒绝启动。生成示例：openssl rand -base64 48
JWT_SECRET=
# 演示账号 admin / analyst / user 的初始密码（至少 8 位）。local profile 启动时自动创建这三个账号，
# 只在账号不存在时创建，之后修改这里不会改变已有账号的密码
DEMO_USER_PASSWORD=
# 每个客户端 IP 每分钟允许的登录次数
APP_LOGIN_RATE_LIMIT_PER_MINUTE=10

# ---------- 模型服务（M0 Spike 与 M2 起使用）----------
# 通义 DashScope OpenAI 兼容模式；Key 只能通过环境变量或本文件注入
# Spring AI 2.0 底层是 OpenAI 官方 SDK，地址必须以 /v1 结尾（不带 /v1 会 404，见 ARCHITECTURE.md §2.2 S2）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v3
AI_EMBEDDING_DIMENSIONS=1024

# ---------- 应用 ----------
APP_STORAGE_ROOT=./data/storage
# NONE 或 MASKED_PREVIEW
APP_LLM_LOG_CONTENT=MASKED_PREVIEW
APP_LOG_RETENTION_DAYS=30
APP_RATE_LIMIT_PER_MINUTE=20
APP_AGENT_TOOL_BUDGET=6
